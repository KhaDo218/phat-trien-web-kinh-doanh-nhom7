# =====================================================================
# CẤU HÌNH API KEY CHO ROOMCRAFT AI CHATBOT
# =====================================================================
# 1. Đổi tên file này thành .env (hoặc tạo file .env mới tại thư mục gốc)
# 2. Dán Gemini API Key của bạn vào bên dưới (lấy miễn phí tại: https://aistudio.google.com/app/apikey)
# 3. Khởi chạy server: python server.py (hoặc node server.js)

GEMINI_API_KEY=your_gemini_api_key_here
PORT=3000
